<?xml version="1.0" encoding="utf-8" ?>
<!--
    Shared content of the BindingContext repro page (see upstream PR #262).
    It is rendered twice: once directly in the page (plain MAUI, reference behavior)
    and once inside a BottomSheet. The three blocks must behave the same in both places.
-->
<ContentView
    x:Class="Plugin.Maui.BottomSheet.Sample.Views.BindingContextReproContent"
    x:DataType="vm:BindingContextReproViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:views="clr-namespace:Plugin.Maui.BottomSheet.Sample.Views"
    xmlns:vm="clr-namespace:Plugin.Maui.BottomSheet.Sample.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <VerticalStackLayout Spacing="12">

        <!-- 1. Inherited context: always works. -->
        <Border Padding="8" StrokeThickness="1">
            <VerticalStackLayout Spacing="4">
                <Label FontAttributes="Bold" Text="1. Inherited BindingContext" />
                <Label Text="{Binding Title}" />
                <views:BindingContextProbe ExpectedType="BindingContextReproViewModel" />
            </VerticalStackLayout>
        </Border>

        <!-- 2. Child view whose BindingContext is bound to a property of the parent. -->
        <Border Padding="8" StrokeThickness="1">
            <ContentView BindingContext="{Binding Child}">
                <VerticalStackLayout Spacing="4" x:DataType="vm:ChildContextViewModel">
                    <Label FontAttributes="Bold" Text="2. BindingContext=&quot;{Binding Child}&quot;" />
                    <Label Text="{Binding Name}" />
                    <views:BindingContextProbe ExpectedType="ChildContextViewModel" />
                </VerticalStackLayout>
            </ContentView>
        </Border>

        <!-- 3. Child view with an explicit, local BindingContext. -->
        <Border Padding="8" StrokeThickness="1">
            <ContentView>
                <ContentView.BindingContext>
                    <vm:ExplicitChildContextViewModel />
                </ContentView.BindingContext>
                <VerticalStackLayout Spacing="4" x:DataType="vm:ExplicitChildContextViewModel">
                    <Label FontAttributes="Bold" Text="3. Explicit local BindingContext" />
                    <Label Text="{Binding Name}" />
                    <views:BindingContextProbe ExpectedType="ExplicitChildContextViewModel" />
                </VerticalStackLayout>
            </ContentView>
        </Border>

        <!-- 4. List rows: each row gets its item as BindingContext (BindableLayout, ItemsControl-like). -->
        <Border Padding="8" StrokeThickness="1">
            <VerticalStackLayout Spacing="4">
                <Label FontAttributes="Bold" Text="4. List rows (BindableLayout, item as BindingContext)" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReproItemViewModel">
                            <VerticalStackLayout>
                                <Label Text="{Binding Name}" />
                                <views:BindingContextProbe ExpectedType="ReproItemViewModel" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>
